{
  "name": "opensearch-workspace",
  "private": true,
  "scripts": {
    "dev:nuxt": "pnpm --filter nuxt-opensearch-demo dev",
    "build:nuxt": "pnpm --filter nuxt-opensearch-demo build",
    "prepare:nuxt": "pnpm --filter nuxt-opensearch-demo prepare",
    "dev:vite": "pnpm --filter vite-opensearch-demo dev",
    "build:vite": "pnpm --filter vite-opensearch-demo build",
    "dev:docs": "pnpm --filter opensearch-docs dev",
    "build:docs": "pnpm --filter opensearch-docs build",
    "build:module": "pnpm --filter nuxt-opensearch prepack",
    "test:module": "pnpm --filter nuxt-opensearch test",
    "test:types:module": "pnpm --filter nuxt-opensearch test:types",
    "build:plugin": "pnpm --filter vite-plugin-opensearch build",
    "test:plugin": "pnpm --filter vite-plugin-opensearch test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:shared",
    "eslint": "catalog:shared",
    "typescript": "catalog:shared",
    "vue-tsc": "catalog:shared"
  },
  "packageManager": "pnpm@12.23.0"
}
