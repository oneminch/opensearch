{
  "name": "opensearch-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter nuxt-opensearch dev",
    "dev:build": "pnpm --filter nuxt-opensearch dev:build",
    "dev:prepare": "pnpm --filter nuxt-opensearch dev:prepare",
    "build": "pnpm --filter nuxt-opensearch prepack",
    "lint": "eslint .",
    "test": "pnpm --filter nuxt-opensearch test",
    "test:watch": "pnpm --filter nuxt-opensearch test:watch",
    "test:types": "pnpm --filter nuxt-opensearch test:types",
    "release": "pnpm --filter nuxt-opensearch release"
  },
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
